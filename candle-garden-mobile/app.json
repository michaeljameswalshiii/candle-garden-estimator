{
  "expo": {
    "name": "Candle Garden Estimator",
    "slug": "candle-garden-estimator",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.michaeljameswalshiii.candlegarden"
    },
    "android": {
      "package": "com.michaeljameswalshiii.candlegarden"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to take photos of your candle containers."
        }
      ],
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7769d138-60fb-46b1-92dc-90cdcdac10d3"
      }
    }
  }
}
